# ── Application ──
APP_NAME=A2UI Web
APP_VERSION=1.0.0
DEBUG=false

# ── Security ──
SECRET_KEY=change-me-to-a-random-64-char-string-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./data/a2ui.db

# ── LLM ──
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096

# ── Odoo MCP ──
ODOO_MCP_URL=http://your-odoo-host:8069
ODOO_MCP_DEFAULT_TOKEN=default-mcp-token

# ── CORS ──
CORS_ORIGINS=["http://localhost","http://localhost:80","http://127.0.0.1"]
