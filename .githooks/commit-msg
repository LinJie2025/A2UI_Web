#!/bin/bash
# =============================================================
# commit-msg hook: 校验 Conventional Commits 格式
# =============================================================

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 跳过 merge commit
if echo "$COMMIT_MSG" | grep -qE '^Merge (branch|pull request)'; then
    exit 0
fi

# 跳过 revert commit
if echo "$COMMIT_MSG" | grep -qE '^Revert "'; then
    exit 0
fi

# Conventional Commits 正则
PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|revert|build)(\([a-zA-Z0-9_.-]+\))?!?: .{1,72}$'

FIRST_LINE=$(echo "$COMMIT_MSG" | head -1)

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
    echo ""
    echo "=============================================="
    echo "  COMMIT MESSAGE 格式不符合 Conventional Commits"
    echo "=============================================="
    echo ""
    echo "  你的提交信息:"
    echo "    $FIRST_LINE"
    echo ""
    echo "  正确格式:"
    echo "    <type>(<scope>): <简短描述>"
    echo ""
    echo "  允许的 type:"
    echo "    feat | fix | docs | style | refactor | perf"
    echo "    test | chore | ci | revert | build"
    echo ""
    echo "  示例:"
    echo "    feat(backend): 添加用户登录接口"
    echo "    fix(frontend): 修复侧边栏宽度计算错误"
    echo "    chore(deps): 升级依赖版本"
    echo ""
    echo "  提示: 使用 git commit 时会打开模板提示"
    echo "=============================================="
    echo ""
    exit 1
fi

exit 0
